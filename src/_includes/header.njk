<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <svg class="brand-mark" viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <circle cx="32" cy="32" r="30" stroke="#BC9455" stroke-width="1.3"/>
        <path d="M20 42C24 29 30 22 32 13" stroke="#71805A" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M32 13c2.2 3 1 6.3-2.2 7.2" stroke="#71805A" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M24.5 31c3-1 5 1 4.8 4" stroke="#71805A" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M21.5 37c3-1 5 1 4 4" stroke="#71805A" stroke-width="1.2" stroke-linecap="round"/>
        <text x="32" y="53" text-anchor="middle" font-family="Fraunces, serif" font-size="12.5" fill="#48522F">V·B</text>
      </svg>
      <span class="brand-text">{{ site.brandName }}<small>{{ site.tagline }}</small></span>
    </a>
    <nav class="main-nav" id="main-nav">
      <a href="/" {% if page.url == '/' %}class="is-active"{% endif %}>Accueil</a>
      <a href="/a-propos/" {% if '/a-propos/' in page.url %}class="is-active"{% endif %}>Qui suis-je</a>
      <a href="/prestations/" {% if '/prestations/' in page.url %}class="is-active"{% endif %}>Prestations</a>
      <a href="/blog/" {% if '/blog' in page.url %}class="is-active"{% endif %}>Blog</a>
      <a href="/contact/" {% if '/contact/' in page.url %}class="is-active"{% endif %}>Contact</a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener" class="nav-instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="width:15px;height:15px;vertical-align:-2px;margin-right:.35em;"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1"/></svg>Instagram
      </a>
    </nav>
    <div class="header-actions">
      <a class="icon-link only-desktop" href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram de {{ site.brandName }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1"/></svg>
      </a>
      <a class="icon-link only-desktop" href="tel:{{ site.phoneHref }}" aria-label="Appeler {{ site.brandName }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg>
      </a>
      <a class="btn btn-primary btn-sm" href="/contact/">Prendre RDV</a>
      <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
