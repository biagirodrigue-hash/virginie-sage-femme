---
layout: base.njk
title: Virginie Biagi
description: "Virginie Biagi, sage-femme indépendante : suivi de grossesse, préparation à la naissance, allaitement, suivi post-natal et massages pré/post-nataux, à domicile ou en cabinet."
---
{% import "icons.njk" as icons %}
<section class="hero container">
  <div class="hero-copy">
    <p class="eyebrow">{{ home.heroEyebrow }}</p>
    <h1>{{ home.heroTitle }}</h1>
    <p class="lede">{{ home.heroLede }}</p>
    <div class="hero-cta-row">
      <a href="/contact/" class="btn btn-primary">Prendre rendez-vous</a>
      <a href="/prestations/" class="btn btn-outline">Découvrir les prestations</a>
    </div>
    <ul class="hero-trust">
      {% for item in home.heroTrust %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  <div class="hero-visual">
    <div class="blob">
      <img src="{{ home.heroImage }}" alt="Virginie Biagi, sage-femme" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:center top;">
    </div>
    <div class="badge">
      <span>💬</span>
      <span><strong>Écoute</strong>et bienveillance à chaque étape</span>
    </div>
  </div>
</section>

<div class="container">
  <div class="reassurance">
    <div class="reassurance-grid">
      <div class="reassurance-item">
        <span class="ico">{{ icons.icon("bouclier") }}</span>
        <div><h4>Déontologie &amp; confidentialité</h4><p>Chaque échange reste strictement couvert par le secret professionnel.</p></div>
      </div>
      <div class="reassurance-item">
        <span class="ico">{{ icons.icon("coeur") }}</span>
        <div><h4>Écoute bienveillante</h4><p>Un accompagnement sans jugement, à l'écoute de vos besoins et de votre rythme.</p></div>
      </div>
      <div class="reassurance-item">
        <span class="ico">{{ icons.icon("horloge") }}</span>
        <div><h4>Rendez-vous flexibles</h4><p>À domicile ou en cabinet, des créneaux adaptés à votre grossesse.</p></div>
      </div>
      <div class="reassurance-item">
        <span class="ico">{{ icons.icon("diplome") }}</span>
        <div><h4>Formation continue</h4><p>{{ home.yearsExperience }} d'expérience et une pratique actualisée en continu.</p></div>
      </div>
    </div>
  </div>
</div>

<section class="container">
  <div class="text-center max-w mx-auto">
    <p class="eyebrow" style="justify-content:center">Prestations</p>
    <h2>Un accompagnement complet, à chaque étape</h2>
    <p class="lede mx-auto">De la préparation à la naissance jusqu'au retour à la maison, chaque prestation est pensée pour vous et votre bébé.</p>
  </div>
  <div class="leaf-divider">
    <svg viewBox="0 0 90 20" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M0 10c10-9 18 9 28 0s18-9 28 0 18-9 28 0-18 9 6 0" stroke-linecap="round"/></svg>
  </div>
  <div class="grid grid-3" style="margin-top:36px;">
    {% for s in services %}
    <div class="card card-service">
      <span class="ico">{{ icons.icon(s.icon) }}</span>
      <h3>{{ s.title }}</h3>
      <p>{{ s.summary }}</p>
      <a class="card-link" href="/prestations/#{{ s.id }}">En savoir plus {{ icons.icon("fleche") }}</a>
    </div>
    {% endfor %}
  </div>
</section>

<section class="container">
  <div class="split">
    <div class="split-visual">
      <img src="{{ home.aboutImage }}" alt="" loading="lazy">
    </div>
    <div>
      <p class="eyebrow">Qui suis-je</p>
      <h2>Une approche humaine du métier de sage-femme</h2>
      <p class="lede">{{ home.aboutText }}</p>
      <ul class="tick-list">
        <li>{{ icons.icon("coche") }} Diplômée d'État, formation continue</li>
        <li>{{ icons.icon("coche") }} Écoute active et disponibilité</li>
        <li>{{ icons.icon("coche") }} Secret professionnel garanti</li>
      </ul>
      <a href="/a-propos/" class="btn btn-outline">Mon parcours en détail</a>
    </div>
  </div>
</section>

<section class="container">
  <div class="text-center max-w mx-auto">
    <p class="eyebrow" style="justify-content:center">Témoignages</p>
    <h2>Ce que partagent les familles accompagnées</h2>
  </div>
  <div class="grid grid-3" style="margin-top:32px;">
    <div class="testimonial">
      <span class="badge-pill">Exemple — emplacement réservé</span>
      <p>« Cet espace accueillera bientôt les retours des familles accompagnées par Virginie, avec leur accord. »</p>
      <span class="who">— À compléter avec de vrais témoignages</span>
    </div>
    <div class="testimonial">
      <span class="badge-pill">Exemple — emplacement réservé</span>
      <p>« Idéal pour rassurer une future maman qui découvre le site pour la première fois. »</p>
      <span class="who">— À compléter avec de vrais témoignages</span>
    </div>
    <div class="testimonial">
      <span class="badge-pill">Exemple — emplacement réservé</span>
      <p>« Les avis Google pourront aussi être intégrés ici une fois la fiche établissement en place. »</p>
      <span class="who">— À compléter avec de vrais témoignages</span>
    </div>
  </div>
</section>

<section class="container">
  <div class="text-center max-w mx-auto">
    <p class="eyebrow" style="justify-content:center">Blog</p>
    <h2>Conseils autour de la maternité</h2>
    <p class="lede mx-auto">Grossesse, accouchement, allaitement, post-partum : des articles pour vous informer entre deux rendez-vous.</p>
  </div>
  <div class="grid grid-3" style="margin-top:32px;">
    {% for post in collections.blogPosts %}
    {% if loop.index <= 3 %}
    <a class="blog-card" href="{{ post.url }}" style="text-decoration:none;color:inherit;">
      <div class="thumb" {% if post.data.cover %}style="background-image:url('{{ post.data.cover }}');background-size:cover;background-position:center;"{% endif %}></div>
      <div class="body">
        <span class="meta">{{ post.data.category }}</span>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.excerpt }}</p>
      </div>
    </a>
    {% endif %}
    {% endfor %}
  </div>
  <div class="text-center" style="margin-top:30px;">
    <a href="/blog/" class="btn btn-outline">Voir tous les articles</a>
  </div>
</section>

<section class="container">
  <div class="split">
    <div class="split-visual">
      <img src="{{ home.instagramImage }}" alt="" loading="lazy" style="aspect-ratio:4/3;object-fit:cover;">
    </div>
    <div>
      <p class="eyebrow">Instagram</p>
      <h2>Suivez le quotidien du cabinet</h2>
      <p class="lede">{{ home.instagramText }}</p>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener" class="btn btn-outline">
        {{ icons.icon("instagram") }} {{ site.instagramHandle }}
      </a>
    </div>
  </div>
</section>

<section class="container">
  <div class="cta-band">
    <div>
      <h2>{{ home.ctaTitle }}</h2>
      <p>{{ home.ctaText }}</p>
    </div>
    <div class="actions">
      <a href="/contact/" class="btn btn-primary">Prendre rendez-vous</a>
      <a href="{{ site.whatsapp }}" target="_blank" rel="noopener" class="btn btn-ghost">Écrire sur WhatsApp</a>
    </div>
  </div>
</section>
